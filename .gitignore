# Root configuration is versioned downstream; variants and recovery state stay local
.env
.env.*
!/.env.example
!/.env
.sync-state/
scratch/
migrations/**/attempt-event.*.json
dist/

# Local worktree/developer caches
.worktrees/
.venv/
.venv-graphify/
__pycache__/
*.pyc
*.egg-info/

# SQLcl deployment bindings may contain local connection names or IDs.
apps/**/deployments/default.json
apps/**/apex-team-export.json

# The Windows Python install manager unpacks a runtime and writes its log into the
# current folder when its python3/py alias runs without LOCALAPPDATA.
/Python/
python_install_*.log

# Local graph/build output
graphify-out/

# Local APEX background probe run files (SQLcl logs, reports, and app staging).
.agents/skills/apex-background/probe/.run/
.claude/skills/apex-background/probe/.run/

# Legacy local skill payloads generated before uc-apx retirement. Keep them
# ignored so a template upgrade does not expose them for accidental commits.
# Project-authored skills remain visible and versioned.
/.agents/skills/uc-apx/
/.claude/skills/uc-apx/
