# Copy to .env and adjust to the connections available in this developer checkout.
# Values are parsed literally. Put comments on separate lines.
# Never store passwords, tokens, wallets, or credential-bearing URLs here.

# Purpose: Human-readable project name.
PROJECT_NAME=apex-team-template

# Purpose: Your name in the publish tag stamped into the app version on each
# DEV publish, e.g. "V2 [ALICE-2026-09-26r001]". Uppercase letters, digits, _.
DEVELOPER_NAME=ALICE

# Purpose: Actual APEX Builder developer/admin login used to own native locks.
# Independent of the database session user and the version-author name above.
# Set this to your account in the target DEV workspace; emails are valid logins.
# DEMO is the existing Builder account in the local Docker demonstration.
APEX_WORKSPACE_USERNAME=DEMO

# Purpose: Classifies the shared development database for safety checks.
DB_ENVIRONMENT=development

# Purpose: Numeric APEX application IDs used by export commands (at most 18 digits each).
APEX_APP_ID=100,200

# Several schemas in one workspace: give any of the schema, connection and
# expected-user keys below a comma-separated list. The three keys of a profile
# must list the same number of entries, in the same order, and each schema must
# appear once. Example:
#   CODE_SCHEMA=APP_ONE,APP_TWO
#   CODE_SQLCL_CONNECTION=dev_app_one,dev_app_two
#   CODE_EXPECTED_USER=APP_ONE,APP_TWO
# Prefix filters apply to every schema in the profile. STAGING_* and PROD_*
# take the same lists, with matching schema names across environments.
# A project with a single DEV schema may name its staging or production schema
# differently, and that mapping applies only to the project's one configured
# DEV schema. An unlisted schema is never mapped to a target.
# Pass --schema <NAME> to scripts/team.sh to run one schema.

# Optional read-only catalog access for `compare-env` sections that require
# DBA views. Configure at most one saved connection alias per environment;
# the command uses it only with SET TRANSACTION READ ONLY and never for writes.
# A missing alias leaves those sections as explicit comparison blockers.
# DEV_DBA_SQLCL_CONNECTION=dev-dba-readonly
# STAGING_DBA_SQLCL_CONNECTION=stage-dba-readonly
# PROD_DBA_SQLCL_CONNECTION=prod-dba-readonly

# Table metadata mirror profile. Use the same saved SQLcl connection if desired.
TABLES_SCHEMA=DEMO
TABLES_PREFIXES=*
TABLES_SQLCL_CONNECTION=docker-demo
TABLES_EXPECTED_USER=DEMO

# Code metadata mirror profile. It may use the same saved SQLcl connection.
CODE_SCHEMA=DEMO
CODE_PREFIXES=*
CODE_SQLCL_CONNECTION=docker-demo
CODE_EXPECTED_USER=DEMO

# Optional migration owner, independently of the metadata mirror above.
# Configure all three keys or none. Absent profiles retain the original CODE
# (DEV) or STAGING/PROD target. Each triple accepts position-aligned lists.
# MIGRATION_SCHEMA=CUSTDATA,API
# MIGRATION_SQLCL_CONNECTION=data-dev,api-dev
# MIGRATION_EXPECTED_USER=DATA_DEPLOYER,API_DEPLOYER
# STAGING_MIGRATION_SCHEMA=CUSTDATA,API
# STAGING_MIGRATION_SQLCL_CONNECTION=data-stage,api-stage
# STAGING_MIGRATION_EXPECTED_USER=DATA_DEPLOYER,API_DEPLOYER
# PROD_MIGRATION_SCHEMA=CUSTDATA,API
# PROD_MIGRATION_SQLCL_CONNECTION=data-prod,api-prod
# PROD_MIGRATION_EXPECTED_USER=DATA_DEPLOYER,API_DEPLOYER

# Optional SQLcl runtime limits for migrations. Defaults are 300 seconds for
# apply and check/inventory sessions, with a 2 MiB generated check-driver budget.
# Timeout values may be fractional seconds; all values must be positive.
# MIGRATION_APPLY_TIMEOUT_SECONDS=300
# MIGRATION_CHECK_TIMEOUT_SECONDS=300
# MIGRATION_CHECK_BATCH_BYTES=2097152
# Retry the full live owner-inventory/definition capture this many times after
# object names or types change during capture (zero disables retries; default 3).
# MIGRATION_PREFLIGHT_INVENTORY_RETRIES=3

# Optional ORDS (REST) metadata mirror profile for `backup-ords`. Leave all three
# commented out to keep ORDS disabled; configure all three or none. The saved
# connection must log in as the REST schema owner: ORDS_EXPECTED_USER must equal
# ORDS_SCHEMA. Lists work as for the profiles above. See docs/ords-export.md.
# ORDS_SCHEMA=REST_API
# ORDS_SQLCL_CONNECTION=dev-rest
# ORDS_EXPECTED_USER=REST_API

# Shared development APEX export and publish profile.
APEX_PARSING_SCHEMA=DEMO
APEX_SQLCL_CONNECTION=docker-demo
APEX_EXPECTED_USER=DEMO

# Optional app-deployment profiles. Configure each connection and expected
# user together. Migration and compare-schema commands also require the
# matching explicit target schema; it may differ from CODE_SCHEMA.
# PROD_SQLCL_CONNECTION=prod-db
# PROD_EXPECTED_USER=PROD_DEPLOYER
# PROD_SCHEMA=APP_PROD
# STAGING_SQLCL_CONNECTION=stage-db
# STAGING_EXPECTED_USER=STAGE_DEPLOYER
# STAGING_SCHEMA=APP_STAGE
