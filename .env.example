# Copy to .env and adjust to the connections available in this developer checkout.
# Values are parsed literally. Put comments on separate lines.
# Never store passwords, tokens, wallets, or credential-bearing URLs here.

# Purpose: Human-readable project name.
PROJECT_NAME=apex-team-template

# Purpose: Your name in the publish tag stamped into the app version on each
# DEV publish, e.g. "V2 [ALICE-2026-09-26r001]". Uppercase letters, digits, _.
DEVELOPER_NAME=ALICE

# Purpose: Classifies the shared development database for safety checks.
DB_ENVIRONMENT=development

# Purpose: Numeric APEX application IDs used by export commands.
APEX_APP_ID=100,200

# Table metadata mirror profile. Use the same saved SQLcl connection if desired.
TABLES_SCHEMA=DEMO
TABLES_PREFIXES=*
TABLES_SQLCL_CONNECTION=docker-demo
TABLES_EXPECTED_USER=DEMO

# Code metadata mirror profile. It may use the same saved SQLcl connection.
CODE_SCHEMA=DEMO
CODE_PREFIXES=*
CODE_SQLCL_CONNECTION=docker-demo
CODE_EXPECTED_USER=DEMO

# Shared development APEX export and publish profile.
APEX_PARSING_SCHEMA=DEMO
APEX_SQLCL_CONNECTION=docker-demo
APEX_EXPECTED_USER=DEMO

# Optional target profiles. Configure each connection and expected user together.
# PROD_SQLCL_CONNECTION=prod-db
# PROD_EXPECTED_USER=PROD_DEPLOYER
# STAGING_SQLCL_CONNECTION=stage-db
# STAGING_EXPECTED_USER=STAGE_DEPLOYER
