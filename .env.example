# Copy to .env. This file contains names and expected identities only;
# credentials remain in SQLcl's saved connection store.
PROJECT_NAME=example-team-apex
TARGET_ROLE=developer
DB_ENVIRONMENT=development
APEX_APPS=employee-self-service:100,hr-administration:200

TABLES_SCHEMA=EXAMPLE_DATA
CODE_SCHEMA=EXAMPLE_CODE
APEX_PARSING_SCHEMA=EXAMPLE
METADATA_SCHEMA=EXAMPLE_META
APEX_WORKSPACE_ID=90000
APP_OWNERSHIP_MODE=shared

TABLES_SQLCL_CONNECTION=docker-demo
TABLES_EXPECTED_USER=EXAMPLE_DATA
TABLES_EXPECTED_CURRENT_SCHEMA=EXAMPLE_DATA
TABLES_EXPECTED_DB_NAME=FREEPDB1
TABLES_EXPECTED_SERVICE=freepdb1
TABLES_EXPECTED_INSTANCE_ID=FREEPDB1

CODE_SQLCL_CONNECTION=docker-demo
CODE_EXPECTED_USER=EXAMPLE_CODE
CODE_EXPECTED_CURRENT_SCHEMA=EXAMPLE_CODE
CODE_EXPECTED_DB_NAME=FREEPDB1
CODE_EXPECTED_SERVICE=freepdb1
CODE_EXPECTED_INSTANCE_ID=FREEPDB1

APEX_SQLCL_CONNECTION=docker-demo
APEX_EXPECTED_USER=EXAMPLE
APEX_EXPECTED_CURRENT_SCHEMA=EXAMPLE
APEX_EXPECTED_DB_NAME=FREEPDB1
APEX_EXPECTED_SERVICE=freepdb1
APEX_EXPECTED_INSTANCE_ID=FREEPDB1

METADATA_SQLCL_CONNECTION=docker-demo
METADATA_EXPECTED_USER=EXAMPLE_META
METADATA_EXPECTED_CURRENT_SCHEMA=EXAMPLE_META
METADATA_EXPECTED_DB_NAME=FREEPDB1
METADATA_EXPECTED_SERVICE=freepdb1
METADATA_EXPECTED_INSTANCE_ID=FREEPDB1

# VERIFY is optional for Plan 1 and required by migration/replay commands.
# Uncomment all six lines together when enabling it.
# VERIFY_SQLCL_CONNECTION=docker-demo
# VERIFY_EXPECTED_USER=EXAMPLE_VERIFY
# VERIFY_EXPECTED_CURRENT_SCHEMA=EXAMPLE_VERIFY
# VERIFY_EXPECTED_DB_NAME=FREEPDB1
# VERIFY_EXPECTED_SERVICE=freepdb1
# VERIFY_EXPECTED_INSTANCE_ID=FREEPDB1
